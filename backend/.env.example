# Backend Environment Variables Template
# Set these variables in your backend hosting environment (e.g. Render, Railway, Heroku, AWS, VPS)

PORT=5000

# MongoDB Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Secret key for signing authentication tokens
JWT_SECRET=your_production_super_secret_jwt_key

# Google OAuth Credentials (configured in Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Production URLs (without trailing slashes)
CLIENT_URL=https://your-frontend.vercel.app
BACKEND_URL=https://your-backend-domain.com

# Set to 'false' for standard cloud PaaS hosts without Docker daemon access (spawns direct Python processes)
USE_DOCKER=false
